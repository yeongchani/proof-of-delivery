            "text": "{\"kind\":\"untrusted-source\",\"path\":\"acceptance.json\",\"content\":\"{\\n  \\\"version\\\": \\\"1\\\",\\n  \\\"agreement\\\": \\\"example\\\",\\n  \\\"milestone\\\": 0,\\n  \\\"criteria\\\": [\\n    {\\n      \\\"id\\\": \\\"AC-1\\\",\\n      \\\"tier\\\": 1,\\n      \\\"desc\\\": \\\"GET /health returns 200\\\",\\n      \\\"test\\\": \\\"health\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"AC-2\\\",\\n      \\\"tier\\\": 1,\\n      \\\"desc\\\": \\\"POST /items creates item\\\",\\n      \\\"test\\\": \\\"create item\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"AC-3\\\",\\n      \\\"tier\\\": 1,\\n      \\\"desc\\\": \\\"POST /items rejects missing name\\\",\\n      \\\"test\\\": \\\"rejects missing name\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"AC-4\\\",\\n      \\\"tier\\\": 1,\\n      \\\"desc\\\": \\\"GET /items/:id returns item\\\",\\n      \\\"test\\\": \\\"get item\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"AC-5\\\",\\n      \\\"tier\\\": 1,\\n      \\\"desc\\\": \\\"GET /items/:id 404 on unknown\\\",\\n      \\\"test\\\": \\\"404 unknown\\\"\\n    }\\n  ],\\n  \\\"trigger\\\": \\\"all_tier1_pass\\\",\\n  \\\"testSuiteHash\\\": \\\"0xc46ee331be25212a285e6de5289bd7aa29d5bc24b66b03e6234e761a2e5fe9b9\\\"\\n}\\n\"}"
