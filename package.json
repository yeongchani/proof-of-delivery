{
  "name": "pod",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Delivery — verification-based settlement protocol for IT outsourcing milestones",
  "license": "MIT",
  "workspaces": [
    "contracts",
    "runner",
    "example-deliverable"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w contracts",
    "test": "npm test --workspaces --if-present",
    "demo": "npm run demo:authority -w contracts",
    "demo:codex": "npm run demo:codex -w contracts",
    "demo:legacy": "npm run demo -w contracts",
    "ai:review": "tsx runner/src/ai-cli.ts",
    "ai:draft": "tsx runner/src/ai-cli.ts --draft",
    "codex:smoke": "tsx runner/src/codex-smoke.ts",
    "cost": "tsx runner/src/cost.ts",
    "keeper": "tsx runner/src/keeper.ts",
    "deploy:sepolia": "npm run deploy:sepolia -w contracts",
    "runner:test": "tsx runner/src/run-tests.ts",
    "policy:hash": "npm run policy:hash -w runner",
    "source:hash": "npm run source:hash -w runner --",
    "typecheck": "tsc --noEmit -p contracts/tsconfig.json && tsc --noEmit -p runner/tsconfig.json && tsc --noEmit -p example-deliverable/tsconfig.json",
    "runner:sign": "npm run sign -w runner",
    "runner:submit": "npm run submit -w runner",
    "authority": "tsx runner/src/authority-cli.ts",
    "demo:cli": "npm run build && tsx contracts/scripts/demo-cli.ts",
    "deploy:authority:sepolia": "npm run deploy:authority:sepolia -w contracts",
    "delivery": "tsx runner/src/delivery-cli.ts"
  }
}
